{
  "name": "dataqualisus-api",
  "version": "0.1.0",
  "description": "API do DataQualiSUS: avaliação e tratamento controlado da qualidade de datasets de saúde (COMP0503 - UFS/DCOMP).",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"../tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"../tests/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" && cd .. && back/node_modules/.bin/eslint -c back/eslint.config.mjs \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:migrar": "ts-node --transpile-only src/cli/migrar.ts",
    "db:seed": "ts-node --transpile-only src/cli/seed-contas-demo.ts",
    "vocabulario:importar": "ts-node --transpile-only src/cli/importar-vocabulario.ts",
    "armazenamento:coletar-orfaos": "ts-node --transpile-only src/cli/coletar-orfaos.ts",
    "test": "jest --config jest.config.js",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:integracao": "jest --config jest-integracao.config.js --runInBand",
    "test:todos": "npm run test && npm run test:integracao"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "csv-parse": "6.1.0",
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.1",
    "@types/pdfkit": "0.17.2",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0"
  }
}
