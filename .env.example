# Copie para back/.env e ajuste para o seu ambiente. Não versione o arquivo .env.

# Porta HTTP da API
PORTA=3000

# Conexão PostgreSQL 16 usada pela API (usuário com privilégios restritos, ver database/papeis.sql)
DATABASE_URL=postgres://dataqualisus_app:troque-esta-senha@localhost:5432/dataqualisus

# Conexão usada somente para migrações (dono do esquema)
DATABASE_URL_MIGRACAO=postgres://dataqualisus:troque-esta-senha@localhost:5432/dataqualisus

# Diretório dos arquivos CSV imutáveis (um arquivo por versão, nomeado pelo SHA-256)
ARMAZENAMENTO_DIR=./armazenamento

# Origem da SPA autorizada a chamar a API com cookies
CORS_ORIGEM=http://localhost:5173

# Sessão no servidor
SESSAO_DURACAO_MINUTOS=480
BCRYPT_CUSTO=12

# Simulação (ADR-008): limite contado a partir do aceite e quantidade de workers
SIMULACAO_LIMITE_MS=60000
SIMULACAO_POOL_TAMANHO=2

# Senhas das contas de demonstração criadas por "npm run db:seed" (somente ambiente acadêmico)
SEED_SENHA_ANALISTA=
SEED_SENHA_GESTOR=
SEED_SENHA_EQUIPE_TECNICA=
